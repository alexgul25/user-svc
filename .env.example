ENV=local

DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432

GRPCSERVER_PORT=50051
# How long to wait for in-flight requests on shutdown before closing connections
GRACEFUL_TIMEOUT=10s
# Example: SERVICES_WITH_EMAIL_HIDDEN=name1,name2,name3
SERVICES_WITH_EMAIL_HIDDEN=gateway-svc

JWT_SECRET=
JWT_ACCESS_TTL=48h
